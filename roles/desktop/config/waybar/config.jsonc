{
  "layer": "top",
  "position": "top",
  "height": 24,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "custom/music", "pulseaudio", "backlight", "network", "bluetooth", "cpu", "battery"],

  "hyprland/workspaces": {
    "on-click": "activate",
    "persistent-workspaces": { "*": 5 }
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "tray": { "spacing": 8 },
  "custom/music": {
    "exec": "~/.local/bin/music-status",
    "return-type": "json",
    "on-click": "~/.local/bin/music",
    "on-click-right": "playerctl -p spotify play-pause",
    "on-scroll-up": "playerctl -p spotify next",
    "on-scroll-down": "playerctl -p spotify previous"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 mute",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "backlight": {
    "format": "󰃠 {percent}%"
  },
  "network": {
    "format-wifi": "󰖩 {essid} {signalStrength}%",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "󰖪 off",
    "tooltip-format": "{ifname} {ipaddr} {bandwidthDownBytes}↓ {bandwidthUpBytes}↑",
    "on-click": "alacritty -e nmtui"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-no-controller": "",
    "format-connected": "󰂱 {device_alias}",
    "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}: {status}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} {device_battery_percentage}%",
    "on-click": "uwsm app -- alacritty --class bluetui --title Bluetooth -e bluetui",
    "on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
  },
  "cpu": { "format": "󰻠 {usage}%", "interval": 5, "on-click": "~/.local/bin/control-center" },
  "battery": {
    "states": { "warning": 25, "critical": 10 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
  }
}

# Hutong (胡同): marlinos plymouth theme.
# Generated by src/hutong/make.py from hutong.script.in. Do not edit the generated copy.
# Boot goes night -> day with the boot progress; shutdown and reboot go day -> night.
# Esc (plymouth built-in) switches to the text boot log.

LOGICAL_W = @W@;
NIGHTFALL_TICKS = 250;   # refresh runs at 50 Hz: 5 s from day to night when shutting down

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
sw = Window.GetWidth();
sh = Window.GetHeight();

probe = Image("bg.png");
fw = probe.GetWidth();
fh = probe.GetHeight();
# Images are pre-scaled pixel art: only rescale (and blur) when the screen is clearly smaller.
k = 1;
if (fw > sw * 1.05 || fh > sh * 1.05)
  k = Math.Min(sw / fw, sh / fh);
u = fw * k / LOGICAL_W;   # screen pixels per art pixel
ox = Window.GetX() + Math.Int((sw - fw * k) / 2);
oy = Window.GetY() + Math.Int((sh - fh * k) / 2);

fun load(name)
  {
    local.img = Image(name);
    if (k == 1)
      return img;
    return img.Scale(img.GetWidth() * k, img.GetHeight() * k);
  }

fun layer(name, z)
  {
    local.s = Sprite(load(name));
    s.SetPosition(ox, oy, z);
    return s;
  }

fun place(s, lx, ly, z)
  {
    s.SetPosition(ox + Math.Int(lx * u), oy + Math.Int(ly * u), z);
  }

fun clamp01(v)
  {
    if (v < 0)
      return 0;
    if (v > 1)
      return 1;
    return v;
  }

# ---------------------------------------------------------------- layers (z order)

sky_day = layer("sky-day.png", 0);
sky_dawn = layer("sky-dawn.png", 1);
sky_night = layer("sky-night.png", 2);
sun = Sprite(load("sun.png"));
moon = Sprite(load("moon.png"));
bg = layer("bg.png", 10);
mid = layer("mid.png", 30);
night = layer("night.png", 100);
lights = layer("lights.png", 101);

# ---------------------------------------------------------------- characters (generated)

@OBJECTS@

for (i = 0; i < idle_count; i++)
  {
    idle[i].sprite = Sprite(idle[i].frames[0]);
    idle[i].last = 0;
    place(idle[i].sprite, idle[i].x, idle[i].y, idle[i].z);
  }
for (i = 0; i < walker_count; i++)
  {
    walker[i].sprite = Sprite(walker[i].frames[0]);
    walker[i].last = 0;
    place(walker[i].sprite, walker[i].x, walker[i].y, walker[i].z);
  }

# ---------------------------------------------------------------- HUD

mode = Plymouth.GetMode();
if (mode == "shutdown")
  label_name = "label-shutdown.png";
else if (mode == "reboot")
  label_name = "label-reboot.png";
else
  label_name = "label-boot.png";

hud = Sprite(load("hud.png"));
hud_x = Math.Int((LOGICAL_W - 150) / 2);
place(hud, hud_x, 166, 200);
label_image = load(label_name);
label = Sprite(label_image);
label_lx = (LOGICAL_W - label_image.GetWidth() / u) / 2;
place(label, label_lx, 168, 201);
cursor = Sprite(load("bar-fill.png").Scale(Math.Int(3 * u), Math.Int(5 * u)));
place(cursor, label_lx + label_image.GetWidth() / u + 2, 171, 201);
bar = Sprite(load("bar.png"));
place(bar, (LOGICAL_W - 122) / 2, 181, 201);
fill_source = Image("bar-fill.png");
fill = Sprite();

fun set_fill(frac)
  {
    local.w = Math.Max(1, Math.Int(120 * u * frac));
    fill.SetImage(fill_source.Scale(w, Math.Int(3 * u)));
    place(fill, (LOGICAL_W - 122) / 2 + 1, 182, 202);
  }

# ---------------------------------------------------------------- time of day

if (mode == "boot")
  tod = 0;
else
  tod = 1;
target = tod;
shown = -1;
progress = 0;

fun progress_callback(duration, p)
  {
    global.progress = p;
  }
Plymouth.SetBootProgressFunction(progress_callback);

fun apply_tod()
  {
    local.t = tod;
    sky_night.SetOpacity(clamp01(1 - t / 0.4));
    if (t < 0.4)
      sky_dawn.SetOpacity(1);
    else
      sky_dawn.SetOpacity(clamp01(1 - (t - 0.4) / 0.4));
    night.SetOpacity(clamp01(1 - t / 0.55));
    lights.SetOpacity(clamp01(1 - t / 0.45));

    # the moon sinks to the right as night ends; the sun rises from behind the roofs on the left
    local.m = clamp01(t / 0.45);
    place(moon, 70 + m * 200, 22 + m * 90, 3);
    local.s = clamp01((t - 0.3) / 0.7);
    place(sun, 16 + s * 210, 104 - Math.Sin(s * 1.9) * 84, 3);

    for (local.i = 0; i < walker_count; i++)
      if (walker[i].day_only)
        walker[i].sprite.SetOpacity(clamp01((t - 0.4) / 0.4));

    if (mode == "boot")
      set_fill(t);
    else
      set_fill(1 - t);
  }

# ---------------------------------------------------------------- animation

tick = 0;
fun refresh_callback()
  {
    global.tick++;
    if (mode == "boot")
      global.target = Math.Max(target, clamp01(progress * 1.15));
    else
      global.target = clamp01(1 - tick / NIGHTFALL_TICKS);
    global.tod = tod + (target - tod) * 0.04;
    local.q = Math.Int(tod * 60);
    if (q != shown)
      {
        apply_tod();
        global.shown = q;
      }

    for (local.i = 0; i < idle_count; i++)
      {
        local.f = Math.Int(tick / idle[i].period) % idle[i].n;
        if (f != idle[i].last)
          {
            idle[i].sprite.SetImage(idle[i].frames[f]);
            global.idle[i].last = f;
          }
      }

    for (local.i = 0; i < walker_count; i++)
      {
        global.walker[i].x = walker[i].x + walker[i].speed;
        if (walker[i].speed > 0 && walker[i].x > LOGICAL_W + 2)
          global.walker[i].x = -walker[i].w;
        if (walker[i].speed < 0 && walker[i].x < -walker[i].w)
          global.walker[i].x = LOGICAL_W + 2;
        local.f = Math.Int(tick / walker[i].period) % walker[i].n;
        if (f != walker[i].last)
          {
            walker[i].sprite.SetImage(walker[i].frames[f]);
            global.walker[i].last = f;
          }
        place(walker[i].sprite, walker[i].x, walker[i].y, walker[i].z);
      }

    if (Math.Int(tick / 25) % 2)
      cursor.SetOpacity(0);
    else
      cursor.SetOpacity(1);
  }
Plymouth.SetRefreshFunction(refresh_callback);

# ---------------------------------------------------------------- password & messages

prompt_sprite = Sprite();
fun display_password_callback(prompt, bullets)
  {
    local.stars = "";
    for (local.i = 0; i < bullets; i++)
      stars = stars + "*";
    prompt_sprite.SetImage(Image.Text(prompt + "  " + stars, 1, 0.9, 0.6));
    place(prompt_sprite, 8, 150, 300);
    prompt_sprite.SetOpacity(1);
  }
fun display_normal_callback()
  {
    prompt_sprite.SetOpacity(0);
  }
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

message_sprite = Sprite();
fun message_callback(text)
  {
    message_sprite.SetImage(Image.Text(text, 1, 1, 1));
    place(message_sprite, 4, 4, 300);
  }
Plymouth.SetMessageFunction(message_callback);

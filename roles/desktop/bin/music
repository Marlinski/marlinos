#!/bin/bash
# Music: ncspot in a tiled terminal. Run again (click the note in the bar, or Super+M) to jump to it.
if [[ ${1:-} == --run ]]; then
  ncspot || read -rp "ncspot exited with an error; Enter to close"
  exit
fi
if hyprctl clients | grep -q 'class: music$'; then
  exec hyprctl dispatch focuswindow class:music >/dev/null
fi
exec uwsm app -- alacritty --class music --title Music -e "$0" --run

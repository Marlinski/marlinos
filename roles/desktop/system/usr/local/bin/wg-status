#!/bin/bash
# marlinos: WireGuard peer status for the control center, as root (wg show needs it).
# Every 5 s writes /run/wg-status/wg0 (world readable, no keys but public ones), one peer a line:
#   name public-key endpoint allowed-ips latest-handshake rx-bytes tx-bytes
# Names come from the comment line after each [Peer] in /etc/wireguard/wg0.conf.
set -u
conf=/etc/wireguard/wg0.conf
out=/run/wg-status/wg0
while :; do
  {
    awk '/^\[Peer\]/ { peer = 1; next }
         peer && /^#/ { name = $2; next }
         peer && /^PublicKey/ { print "name", $3, name; peer = 0; name = "" }' "$conf"
    wg show wg0 dump | awk 'NR > 1 { print "peer", $1, $3, $4, $5, $6, $7 }'   # line 1 holds the private key
  } | awk '$1 == "name" { n[$2] = ($3 == "" ? "?" : $3); next }
           { print ($2 in n ? n[$2] : "?"), $2, $3, $4, $5, $6, $7 }' > "$out.tmp" && mv "$out.tmp" "$out"
  sleep 5
done

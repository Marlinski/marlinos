# marlinos (minix): load /etc/nftables/firewall.nft (table inet firewall).
# Not nftables.service: that one runs `nft flush ruleset` on stop, wiping docker's and k3s's rules.
# This one only ever replaces or deletes its own table.
[Unit]
Description=Firewall (nftables table inet firewall)
DefaultDependencies=no
Before=network-pre.target shutdown.target
Wants=network-pre.target
After=local-fs.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nft -f /etc/nftables/firewall.nft
ExecReload=/usr/bin/nft -f /etc/nftables/firewall.nft
ExecStop=/usr/bin/nft delete table inet firewall

[Install]
WantedBy=sysinit.target

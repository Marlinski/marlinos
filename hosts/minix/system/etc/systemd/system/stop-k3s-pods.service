# marlinos (minix): stop k3s pods cleanly at shutdown.
# k3s.service uses KillMode=process, so its pod containers outlive it and systemd-shutdown
# waits on them (then hangs unmounting their overlays). k3s-killall.sh kills the pods and
# unmounts their volumes. Before=k3s.service means that at shutdown this stops *after* k3s,
# so the script's own `systemctl stop k3s` returns at once instead of waiting on us (deadlock).
# (Not named k3s*: k3s-killall.sh stops every k3s*.service.)
[Unit]
Description=Stop k3s pods after k3s at shutdown
Before=k3s.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/bin/k3s-killall.sh
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target

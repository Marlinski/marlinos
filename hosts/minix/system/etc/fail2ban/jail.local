[DEFAULT]
# Ban hosts for 1 hour:
bantime = 3600

# Check for 3 failures in the last 10 minutes:
findtime = 600
maxretry = 3

# Backend for monitoring log files
backend = systemd

[sshd]
enabled = true
port = 4242
filter = sshd
logpath = %(sshd_log)s
backend = %(sshd_backend)s
maxretry = 3
bantime = 3600
findtime = 600
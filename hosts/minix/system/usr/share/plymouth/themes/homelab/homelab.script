walker[0].frames[1] = load("vacuum-1.png");
walker[0].n = 2; walker[0].x = 120; walker[0].y = 181; walker[0].z = 40; walker[0].speed = 0.18; walker[0].period = 30; walker[0].w = 18; walker[0].day_only = 0;

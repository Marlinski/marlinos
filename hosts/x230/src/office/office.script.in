# Office: marlinos plymouth theme. A cozy study at the window, the X230 on the desk.
# Generated by src/office/make.py from office.script.in. Do not edit the generated copy.
# Boot goes night -> day with the boot progress (sun rises, desk lamp dims);
# shutdown and reboot go day -> night. The cat sleeps, the tea steams, plants sway, dust drifts
# in the sun rays, fairy lights twinkle at night. Boot log, progress and the disk passphrase
# are drawn on the X230's screen in the scene. Esc (plymouth built-in) shows the text log.

LOGICAL_W = @W@;
NIGHTFALL_TICKS = 250;   # refresh runs at 50 Hz: 5 s from day to night when shutting down
SX = @SX@;               # the in-scene screen, logical pixels
SY = @SY@;
SW = @SW@;
SH = @SH@;

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
sw = Window.GetWidth();
sh = Window.GetHeight();

probe = Image("room.png");
fw = probe.GetWidth();
fh = probe.GetHeight();
# Images are pre-scaled pixel art: only rescale (and blur) when the screen is clearly smaller.
k = 1;
if (fw > sw * 1.05 || fh > sh * 1.05)
  k = Math.Min(sw / fw, sh / fh);
u = fw * k / LOGICAL_W;   # screen pixels per art pixel
ox = Window.GetX() + Math.Int((sw - fw * k) / 2);
oy = Window.GetY() + Math.Int((sh - fh * k) / 2);

fun load(name)
  {
    local.img = Image(name);
    if (k == 1)
      return img;
    return img.Scale(img.GetWidth() * k, img.GetHeight() * k);
  }

fun layer(name, z)
  {
    local.s = Sprite(load(name));
    s.SetPosition(ox, oy, z);
    return s;
  }

fun place(s, lx, ly, z)
  {
    s.SetPosition(ox + Math.Int(lx * u), oy + Math.Int(ly * u), z);
  }

fun clamp01(v)
  {
    if (v < 0)
      return 0;
    if (v > 1)
      return 1;
    return v;
  }

# ---------------------------------------------------------------- layers (z order)

sky_day = layer("sky-day.png", 0);
sky_dawn = layer("sky-dawn.png", 1);
sky_night = layer("sky-night.png", 2);
sun = Sprite(load("sun.png"));
moon = Sprite(load("moon.png"));
outside = layer("outside.png", 5);
room = layer("room.png", 10);
sunbeam = layer("sunbeam.png", 30);
dawn = layer("dawn.png", 90);
night = layer("night.png", 100);
lights = layer("lights.png", 101);

# ---------------------------------------------------------------- cat, tea, plants, lights (generated)
# idle[i].lit: 0 always shown, 1 with the sun rays, 2 with the night lights, 3 with the day sky
# idle[i].drift: ticks per pixel moved right (0: still), wrapping every idle[i].span pixels

@OBJECTS@

for (i = 0; i < idle_count; i++)
  {
    idle[i].sprite = Sprite(idle[i].frames[0]);
    idle[i].last = 0;
    idle[i].dx = 0;
    place(idle[i].sprite, idle[i].x, idle[i].y, idle[i].z);
  }

# dust motes floating down the sun rays
mote_image[0] = load("mote-0.png");
mote_image[1] = load("mote-1.png");
for (i = 0; i < mote_count; i++)
  {
    mote[i].sprite = Sprite(mote_image[i % 2]);
    mote[i].sprite.SetOpacity(0);
  }
motes_shown = 0;

# ---------------------------------------------------------------- the X230 screen

mode = Plymouth.GetMode();
if (mode == "shutdown")
  label_name = "label-shutdown.png";
else if (mode == "reboot")
  label_name = "label-reboot.png";
else
  label_name = "label-boot.png";
@LOG_NAMES@

label_image = load(label_name);
label = Sprite(label_image);
place(label, SX + 4, SY + 3, 150);
cursor = Sprite(load("cursor.png"));
place(cursor, SX + 4 + label_image.GetWidth() / u + 1, SY + 6, 150);

LOG_N = @LOG_N@;
UNLOCK_LINE = @UNLOCK_LINE@;
for (i = 0; i < LOG_N; i++)
  {
    if (mode == "boot")
      log[i] = Sprite(load(log_boot[i]));
    else
      log[i] = Sprite(load(log_down[i]));
    place(log[i], SX + 4, SY + @LOG_Y@ + i * @LOG_STEP@, 150);
    log[i].SetOpacity(0);
  }
log_shown = 0;

bar = Sprite(load("bar.png"));
place(bar, SX + 4, SY + @BAR_Y@, 150);
fill_source = Image("bar-fill.png");
fill = Sprite();

fun set_fill(frac)
  {
    local.w = Math.Max(1, Math.Int((@BAR_W@ - 2) * u * frac));
    fill.SetImage(fill_source.Scale(w, Math.Int(3 * u)));
    place(fill, SX + 5, SY + @BAR_Y@ + 1, 151);
  }

fun show_log(n)
  {
    if (n == log_shown)
      return;
    for (local.i = 0; i < LOG_N; i++)
      if (i < n)
        log[i].SetOpacity(1);
      else
        log[i].SetOpacity(0);
    global.log_shown = n;
  }

# ---------------------------------------------------------------- time of day

if (mode == "boot")
  tod = 0;
else
  tod = 1;
target = tod;
shown = -1;
progress = 0;
day_a = 0;      # sun rays and dust
night_a = 1;    # lamp and fairy lights
sky_a = 0;      # clouds

fun progress_callback(duration, p)
  {
    global.progress = p;
  }
Plymouth.SetBootProgressFunction(progress_callback);

fun apply_tod()
  {
    local.t = tod;
    sky_night.SetOpacity(clamp01(1 - t / 0.45));
    if (t < 0.45)
      sky_dawn.SetOpacity(1);
    else
      sky_dawn.SetOpacity(clamp01(1 - (t - 0.45) / 0.35));
    night.SetOpacity(clamp01(1 - t / 0.6));
    global.night_a = clamp01(1 - t / 0.75);       # the desk lamp dims last
    global.day_a = clamp01((t - 0.55) / 0.35);
    global.sky_a = clamp01((t - 0.25) / 0.4);
    lights.SetOpacity(night_a);
    sunbeam.SetOpacity(day_a);
    local.g = (t - 0.42) / 0.22;                   # warm glow around sunrise
    if (g < 0)
      g = -g;
    dawn.SetOpacity(clamp01(1 - g));
    for (local.i = 0; i < idle_count; i++)
      {
        if (idle[i].lit == 1)
          idle[i].sprite.SetOpacity(day_a);
        else if (idle[i].lit == 2)
          idle[i].sprite.SetOpacity(night_a);
        else if (idle[i].lit == 3)
          idle[i].sprite.SetOpacity(sky_a);
      }

    # the moon sinks to the lower right of the window, the sun climbs from the lower left
    local.m = clamp01(t / 0.5);
    place(moon, @MOON_X0@ + m * @MOON_DX@, @MOON_Y0@ + m * @MOON_DY@, 3);
    local.s = clamp01((t - 0.3) / 0.7);
    place(sun, @SUN_X0@ + s * @SUN_DX@, @SUN_Y0@ - Math.Sin(s * 1.6) * @SUN_DY@, 3);
  }

fun update_motes()
  {
    if (day_a <= 0)
      {
        if (motes_shown)
          for (local.i = 0; i < mote_count; i++)
            mote[i].sprite.SetOpacity(0);
        global.motes_shown = 0;
        return;
      }
    global.motes_shown = 1;
    for (local.i = 0; i < mote_count; i++)
      {
        local.p = (Math.Int(tick * mote[i].sp + mote[i].off) % 1000) / 1000;
        local.y = @MOTE_Y0@ + p * @MOTE_H@;
        local.x = mote[i].u + Math.Sin(tick * 0.03 + mote[i].ph) * 3 + (y - @RAY_Y@) * @RAY_DX@;
        local.a = day_a * Math.Sin(p * 3.14159) * (0.65 + 0.35 * Math.Sin(tick * 0.11 + mote[i].ph));
        if (x >= SX && x < SX + SW && y >= SY && y < SY + SH)
          a = 0;
        place(mote[i].sprite, x, y, 35);
        mote[i].sprite.SetOpacity(a);
      }
  }

# ---------------------------------------------------------------- passphrase (on the X230 screen)

PANEL_X = SX + @PANEL_X@;
PANEL_Y = SY + @PANEL_Y@;
DOT_X = PANEL_X + @FIELD_X@ + 3;
DOT_Y = PANEL_Y + @FIELD_Y@ + 3;
DOT_MAX = @DOT_MAX@;
panel = Sprite(load("pass.png"));
place(panel, PANEL_X, PANEL_Y, 160);
panel.SetOpacity(0);
dot_image = load("dot.png");
for (i = 0; i < DOT_MAX; i++)
  {
    dot[i] = Sprite(dot_image);
    place(dot[i], DOT_X + i * @DOT_STEP@, DOT_Y, 161);
    dot[i].SetOpacity(0);
  }
caret = Sprite(load("caret.png"));
caret.SetOpacity(0);
asking = 0;
asked = 0;          # a passphrase was asked this boot: later log lines wait for it
unlocked = 0;

fun display_password_callback(prompt, bullets)
  {
    global.asking = 1;
    global.asked = 1;
    panel.SetOpacity(1);
    for (local.i = 0; i < DOT_MAX; i++)
      if (i < bullets)
        dot[i].SetOpacity(1);
      else
        dot[i].SetOpacity(0);
    place(caret, DOT_X + Math.Min(bullets, DOT_MAX) * @DOT_STEP@, DOT_Y - 1, 161);
  }
fun display_normal_callback()
  {
    if (asking)
      global.unlocked = 1;
    global.asking = 0;
    panel.SetOpacity(0);
    caret.SetOpacity(0);
    for (local.i = 0; i < DOT_MAX; i++)
      dot[i].SetOpacity(0);
  }
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# ---------------------------------------------------------------- animation

tick = 0;
fun refresh_callback()
  {
    global.tick++;
    if (mode == "boot")
      {
        global.target = Math.Max(target, clamp01(progress * 1.15));
        local.n = Math.Int(clamp01(progress * 1.15) * (LOG_N + 1));
        if (asked && !unlocked)
          n = Math.Min(n, UNLOCK_LINE);
      }
    else
      {
        global.target = clamp01(1 - tick / NIGHTFALL_TICKS);
        local.n = Math.Int(tick / 30);
      }
    show_log(Math.Min(n, LOG_N));
    global.tod = tod + (target - tod) * 0.04;
    local.q = Math.Int(tod * 60);
    if (q != shown)
      {
        apply_tod();
        if (mode == "boot")
          set_fill(tod);
        else
          set_fill(1 - tod);
        global.shown = q;
      }

    for (local.i = 0; i < idle_count; i++)
      {
        local.f = Math.Int(tick / idle[i].period) % idle[i].n;
        if (f != idle[i].last)
          {
            idle[i].sprite.SetImage(idle[i].frames[f]);
            global.idle[i].last = f;
          }
        if (idle[i].drift > 0)
          {
            local.dx = Math.Int(tick / idle[i].drift) % idle[i].span;
            if (dx != idle[i].dx)
              {
                place(idle[i].sprite, idle[i].x + dx, idle[i].y, idle[i].z);
                global.idle[i].dx = dx;
              }
          }
      }
    update_motes();

    if (Math.Int(tick / 25) % 2)
      cursor.SetOpacity(0);
    else
      cursor.SetOpacity(1);
    if (asking && Math.Int(tick / 20) % 2 == 0)
      caret.SetOpacity(1);
    else
      caret.SetOpacity(0);
  }
Plymouth.SetRefreshFunction(refresh_callback);

# ---------------------------------------------------------------- messages

message_sprite = Sprite();
fun message_callback(text)
  {
    message_sprite.SetImage(Image.Text(text, 1, 1, 1));
    place(message_sprite, 4, 4, 300);
  }
Plymouth.SetMessageFunction(message_callback);

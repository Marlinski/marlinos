# Hyprland :: the marlinos keys (read live from your hyprland.conf)


!binds ~/.config/hypr/hyprland.conf

## hyprctl
hyprctl clients :: open windows with class, workspace, size
hyprctl activewindow :: the focused one (find a window's class for a rule)
hyprctl reload :: re-read the config
hyprctl dispatch <dispatcher> <arg> :: run any dispatcher (workspace 3, exec foot…)
hyprctl binds :: every key binding
hyprctl monitors :: outputs, scale, refresh rate
Hyprland --verify-config -c ~/.config/hypr/hyprland.conf :: check the config before reloading
> config: roles/desktop/config/hypr/hyprland.conf, per machine: hosts/<host>/hypr.conf

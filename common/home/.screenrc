# screen: Tokyo Night, one bar at the bottom: host | windows (the current one in a pill) | time.
# Prefix Ctrl+a as always. Colors: see ~/.config/tmux/tmux.conf.
startup_message off
vbell off
bell_msg "bell in window %n"
activity "activity in window %n"
defmonitor on
defscrollback 20000
# the screen under a full-screen app (vim, less) comes back when it exits
altscreen on
truecolor on
term screen-256color

hardstatus alwayslastline
hardstatus string "%{= #9ece6a;#16161e}  %{= #c0caf5;#16161e}%H  %{= #565f89;#16161e}%-w%{= #292e42;#16161e}%{= #7aa2f7;#292e42}%n %{= #c0caf5;#292e42}%t%{= #292e42;#16161e}%{= #565f89;#16161e}%+w%=%{= #565f89;#16161e}%D %d %M  %{= #292e42;#16161e}%{= #7aa2f7;#292e42}󰥔 %{= #c0caf5;#292e42}%c%{= #292e42;#16161e} "

# messages in the same colors
rendition so "= #c0caf5;#292e42"
